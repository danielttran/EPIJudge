<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EpiJudge.TestFramework/EpiJudge.TestFramework.csproj" />
    <EmbeddedResource Include="catalog.json" />
    <EmbeddedResource Include="NativeHarnesses/*" />
    <EmbeddedResource Include="../blind75/catalog.json" LogicalName="EpiJudge.Runner.blind75.json" />
    <EmbeddedResource Include="../blind75/runtime/*" LogicalName="EpiJudge.Runner.Blind75Runtime.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
